# Sharewerk configuration. Copy to .env and adjust: cp .env.example .env
# .env is git-ignored. Never commit it.

# --- Access ----------------------------------------------------------------
# token: Sharewerk asks for SHAREWERK_AUTH_TOKEN once per device (stored as a
#        cookie). Generate one with: openssl rand -hex 32
# none:  no own login. ONLY use this behind an authenticating reverse proxy
#        (Pomerium, oauth2-proxy, Authelia, Cloudflare Access ...).
SHAREWERK_AUTH_MODE=token
SHAREWERK_AUTH_TOKEN=

# Set to false only for plain-HTTP testing on localhost.
SHAREWERK_COOKIE_SECURE=true

# --- Downloading -------------------------------------------------------------
# Netscape-format cookies.txt of a logged-in (secondary!) account. Instagram
# needs it for almost everything. Mounted read-only from ./secrets/.
SHAREWERK_COOKIES_FILE=/secrets/cookies.txt
# Optional gallery-dl config file for advanced tweaks.
SHAREWERK_GALLERY_DL_CONFIG=/secrets/gallery-dl.conf
# Comma-separated host allowlist. The default covers Instagram and Facebook.
# SHAREWERK_ALLOWED_HOSTS=instagram.com,www.instagram.com,facebook.com,www.facebook.com,fb.watch
SHAREWERK_MAX_ITEMS=20
SHAREWERK_MAX_DOWNLOAD_MB=500

# --- Processing --------------------------------------------------------------
# Long edge of shared images in pixels. 1568 keeps small text readable while
# the files stay small enough to share quickly.
SHAREWERK_IMAGE_MAX_EDGE=1568
# Maximum key frames taken from one video.
SHAREWERK_MAX_FRAMES=8
# Longer videos are only sampled and transcribed up to this length.
SHAREWERK_MAX_VIDEO_SECONDS=900

# --- Transcription (faster-whisper, CPU) -----------------------------------
# tiny | base | small | medium | large-v3 | off
# small is a good balance on a few CPU cores; the model (~500 MB) is
# downloaded on first use into the data volume.
SHAREWERK_WHISPER_MODEL=small
# Empty = auto-detect per video. Set e.g. "de" to force German.
SHAREWERK_WHISPER_LANGUAGE=
# CPU threads for transcription. 0 = automatic.
SHAREWERK_WHISPER_THREADS=0

# --- Housekeeping ------------------------------------------------------------
# Results are deleted after this many hours.
SHAREWERK_RETENTION_HOURS=24
SHAREWERK_LOG_LEVEL=INFO
